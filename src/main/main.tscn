text = "marker   cube plain   cone up LADDER   cone down SNAKE   diamond GOAL
         a link's marker draws a line to where it drags you
tray     the bright die is the one you roll; the small ones are rerolls
         the foe's die sits on the far side of the screen during a fight
fight    one contest, one roll each — the die you stake is the one you lose"

[node name="Controls" type="Label" parent="HUD/Margin/Rows/Help"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.66, 0.85, 1)
theme_override_fonts/font = SubResource("Font_mono")
theme_override_styles/normal = SubResource("Box_hud")
theme_override_font_sizes/font_size = 16
text = "SPACE     throw: roll, reroll, or stake a die in a fight
number    pick a move on the board — the board's keys, only
LEFT/RIGHT   choose a die      UP/DOWN   choose a contest
click a die pick it up         click a spare  spend it
TAB view    C recentre   M mute   F3 debug (then D dimensions)
SHIFT+R restart the run        ESC close this
drag orbit    right-drag pan    wheel zoom"
